# Copy to leadsheet.env and fill in. To keep it in git, encrypt it with sops:
# sops encrypt leadsheet.env > leadsheet.enc.env (`just up` decrypts it).
POSTGRES_PASSWORD=
# Confidential OAuth client key: docker run --rm leadsheet leadsheet gen-client-key
LEADSHEET_OAUTH_CLIENT_KEY=
# Where the app is served (default https://leadsheet.fm).
# LEADSHEET_PUBLIC_URL=https://chords.example.com

# Optional: an OTLP/HTTP collector for traces, e.g. http://localhost:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=

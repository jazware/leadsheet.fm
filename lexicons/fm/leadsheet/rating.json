{
  "lexicon": 1,
  "id": "fm.leadsheet.rating",
  "description": "A 1-5 star rating of a chord sheet. An account's newest rating of a sheet replaces its earlier ones.",
  "defs": {
    "main": {
      "type": "record",
      "description": "A 1-5 star rating of a chord sheet. An account's newest rating of a sheet replaces its earlier ones.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "subject",
          "value",
          "createdAt"
        ],
        "properties": {
          "subject": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          },
          "value": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
